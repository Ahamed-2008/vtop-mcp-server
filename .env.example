# ---------------------------------------------------------------------------
# VTOP MCP Server configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# VTOP base URL
VTOP_BASE_URL=https://vtop.vit.ac.in

# Login page entry point (the pre-login CSRF/captcha portal is auto-discovered)
VTOP_INITIAL_URL=/vtop/open/page

# Whether login is allowed at all. When false the server is read-only and
# requires an already-established session (see `vtop-mcp login`).
VTOP_ENABLE_LOGIN=true

# Where the persisted, local-only authenticated session is stored.
# The default is <project>/.vtop-session/session.json (permission 0600).
# VTOP_SESSION_PATH=

# How long (seconds) an authenticated session is trusted in-process before a
# cheap liveness re-check against VTOP.
VTOP_SESSION_TTL=3600

# HTTP settings
VTOP_TIMEOUT_CONNECT=10.0
VTOP_TIMEOUT_READ=30.0
VTOP_TIMEOUT_WRITE=10.0

# Transient-failure retries for NON-authentication read requests
# (0 = no retries). Authentication requests are never retried.
VTOP_RETRY_ATTEMPTS=2
VTOP_RETRY_BACKOFF_BASE=0.5

# Short-lived caching of expensive read-only data (seconds).
# 0 disables caching. Session cookies/tokens are never cached here.
VTOP_CACHE_TTL=120

# Logging: DEBUG | INFO | WARNING | ERROR
VTOP_LOG_LEVEL=INFO